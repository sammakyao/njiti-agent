# Copy to .env and fill in.

# OpenAI-compatible endpoint. Leave OPENAI_BASE_URL empty for OpenAI itself,
# or point it at a proxy (e.g. LiteLLM) to use Claude, Gemini, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=
NJITI_MODEL=
# Optional, e.g. 0 for older models. Leave empty for newer models that only accept their default.
NJITI_TEMPERATURE=

# BigQuery knowledge base (optional: without it the agent only uses the built-in WHO facts)
BQ_PROJECT_ID=
BQ_DATASET=
BQ_TABLE=
BQ_LOCATION=us-central1

# Set to 1 to preview the website with a canned answer and no API keys
NJITI_DEMO=0
